{
  "GracePortal": {
    "BaseUrl": "https://grace.learnsdlc.org",
    "ApiKey": "",
    "PollIntervalMs": 2000,
    "MaxConcurrentSteps": 1,
    "ReconnectDelayMs": 5000
  },
  "Playwright": {
    "Browser": "chromium",
    "Headless": false,
    "CdpEndpoint": "",
    "DefaultTimeoutMs": 30000,
    "SlowMoMs": 0,
    "ScreenshotOnFailure": true,
    "VideoOnFailure": false
  },
  "MultiLocator": {
    "Enabled": true,
    "StopOnFirstSuccess": true,
    "LogAllAttempts": true,
    "FailureAnalysis": {
      "Enabled": true,
      "CallPortalOnExhaustion": true,
      "IncludeScreenshot": true,
      "IncludePageUrl": true
    }
  },
  "Scheduler": {
    "NightlyReboot": {
      "Enabled": true,
      "Hour": 0,
      "Minute": 0
    }
  },
  "SelfTest": {
    "RunOnStartup": true,
    "Levels": ["function", "class", "module", "system"],
    "FailOnError": false,
    "ReportToPortal": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning"
    },
    "LogFilePath": "logs/autonomous-agent-.log",
    "RollingInterval": "Day",
    "RetainedFileCount": 14
  }
}
