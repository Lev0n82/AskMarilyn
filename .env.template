# =============================================================================
# CSC-GRACE Platform — Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in the required values.
# The install.sh / install.ps1 scripts do this automatically.
#
# NEVER commit .env to source control.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# MySQL / TiDB connection string. Add ?ssl={"rejectUnauthorized":true} for TLS.
DATABASE_URL=mysql://user:password@host:3306/grace_academy

# ── Authentication ────────────────────────────────────────────────────────────
# Session cookie signing secret — minimum 32 random characters.
JWT_SECRET=change-me-to-a-random-32-char-secret

# Manus OAuth credentials (obtain from https://manus.im/developer)
VITE_APP_ID=your-manus-app-id
OAUTH_SERVER_URL=https://api.manus.im
VITE_OAUTH_PORTAL_URL=https://manus.im/login

# ── Owner ─────────────────────────────────────────────────────────────────────
OWNER_OPEN_ID=owner-open-id
OWNER_NAME=Owner Name

# ── Manus Built-in Services ───────────────────────────────────────────────────
BUILT_IN_FORGE_API_URL=https://forge.manus.im
BUILT_IN_FORGE_API_KEY=your-server-side-forge-api-key
VITE_FRONTEND_FORGE_API_KEY=your-frontend-forge-api-key
VITE_FRONTEND_FORGE_API_URL=https://forge.manus.im

# ── Azure DevOps ──────────────────────────────────────────────────────────────
# Personal Access Token with: Work Items (Read), Test Plans (Read & Write),
# Code (Read & Write), Build (Read).
ADO=your-ado-personal-access-token

# ── GRACE LLM Provider ────────────────────────────────────────────────────────
# Options: manus (default) | azure_openai | ollama | custom
# Settings here are bootstrap overrides; runtime settings in Settings → GRACE
# take precedence once configured.
GRACE_LLM_PROVIDER=manus

# Ollama (local / CPU-optimised — recommended: Granite 4, Llama 3.2)
GRACE_OLLAMA_ENDPOINT=http://localhost:11434
GRACE_OLLAMA_CLOUD_ENDPOINT=
GRACE_LLM_MODEL=

# Azure OpenAI
GRACE_AZURE_OPENAI_ENDPOINT=
GRACE_AZURE_OPENAI_DEPLOYMENT=
GRACE_AZURE_OPENAI_API_VERSION=2024-02-01

# Custom LLM endpoint (OpenAI-compatible)
GRACE_CUSTOM_LLM_ENDPOINT=
GRACE_LLM_API_KEY=

# ── GRACE Quality Thresholds ──────────────────────────────────────────────────
# Minimum scores for AI-generated conditions to pass the confidence gate.
# Values 0.0–1.0. Override at runtime via Settings → GRACE.
GRACE_TESTABILITY_THRESHOLD=0.65
GRACE_CONFIDENCE_THRESHOLD=0.70
GRACE_DUPLICATE_THRESHOLD=0.85

# ── GRACE Playwright / CDP Execution ─────────────────────────────────────────
# Browser for local execution: chromium | firefox | webkit | chrome | edge
GRACE_DEFAULT_BROWSER=chromium
# Remote Chrome DevTools Protocol WebSocket URL (leave blank for local)
GRACE_CDP_ENDPOINT=
# Timeouts in milliseconds
GRACE_STEP_TIMEOUT_MS=30000
GRACE_TESTCASE_TIMEOUT_MS=300000

# ── GRACE Security ────────────────────────────────────────────────────────────
# Comma-separated list of internal hostnames allowed for SSRF-protected requests
GRACE_ALLOWED_HOSTS=

# ── Analytics (optional) ─────────────────────────────────────────────────────
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# ── Application Branding ──────────────────────────────────────────────────────
VITE_APP_TITLE=CSC-GRACE
VITE_APP_LOGO=/logo.svg
