  "matrices": [
    {
      "id": "M01",
      "name": "Governance RACI",
      "group": "governance",
      "courses": [
        3
      ],
      "grain": "One governed decision or QA activity; RACI roles contain R/A/C/I or R/A.",
      "columns": [
        "ActivityId",
        "Activity",
        "QALead",
        "EngineeringLead",
        "ProductOwner",
        "ReleaseOwner",
        "SecurityOwner",
        "EvidenceSource",
        "ReviewDate",
        "AccountabilityCheck"
      ],
      "note": "Assign exactly one accountable role, identify responsible execution and retain the approval evidence. A role assignment is not proof a control operated.",
      "workbook": "qa_matrices_governance.xlsx",
      "sheet": "Governance RACI"
    },
    {
      "id": "M02",
      "name": "Stakeholder Decision",
      "group": "governance",
      "courses": [
        1,
        2,
        4
      ],
      "grain": "One stakeholder information need and decision.",
      "columns": [
        "NeedId",
        "Audience",
        "Decision",
        "AffectedGroup",
        "ActionOwner",
        "EvidenceNeeded",
        "CommunicationForm",
        "AccessNeed",
        "CounterEvidence",
        "ReviewDate"
      ],
      "note": "A dashboard request is not a decision. Include affected users and accessible information needs.",
      "workbook": "qa_matrices_governance.xlsx",
      "sheet": "Stakeholder Decision"
    },
    {
      "id": "M03",
      "name": "Risk Control",
      "group": "governance",
      "courses": [
        3,
        7
      ],
      "grain": "One risk objective and control relationship; repeated objectives are normalized before weighting.",
      "columns": [
        "RiskId",
        "RiskStatement",
        "Impact",
        "Likelihood",
        "LocalPriority",
        "Control",
        "RequirementId",
        "TestId",
        "Owner",
        "ResidualRisk",
        "EvidenceStatus",
        "EvidenceRef"
      ],
      "note": "Impact and likelihood are local ordinal 1-5 scales. Their product is a local prioritization aid, not a probability, expected loss or ISO score.",
      "workbook": "qa_matrices_governance.xlsx",
      "sheet": "Risk Control"
    },
    {
      "id": "M04",
      "name": "Metric Contract",
      "group": "governance",
      "courses": [
        4,
        9,
        11,
        13
      ],
      "grain": "One selected measure for one declared decision/cohort.",
      "columns": [
        "MetricId",
